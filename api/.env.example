PORT=3333
NODE_ENV=development

# Banco de desenvolvimento (docker-compose: serviço "db")
DATABASE_URL=postgres://escolaalerta:escolaalerta@localhost:5432/escolaalerta

# Banco de testes (docker-compose: serviço "db_test")
DATABASE_URL_TEST=postgres://escolaalerta:escolaalerta@localhost:5433/escolaalerta_test

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h

# Origem do front liberada no CORS (separe várias por vírgula)
FRONT_URL=http://localhost:5500,http://127.0.0.1:5500
